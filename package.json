{
  "name": "sdoh-loops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SDOH Loops — map a person's or group's social circumstances with ICD-11 codes and find the loops that hold them in place. On-device only.",
  "scripts": {
    "dev": "vite",
    "build:content": "tsx scripts/build-content.ts",
    "build": "npm run build:content && tsc -b && vite build && npm run build:consumer",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:pack": "python3 tools/validate_pack.py content-pack",
    "lint": "tsc --noEmit",
    "record:tests": "tsx scripts/record-test-run.ts",
    "check": "npm run validate:pack && npm run test && npm run build && npm run test:e2e && npm run record:tests",
    "build:consumer": "vite build --config packages/sdoh-loops-core/fixtures/consumer/vite.config.ts",
    "release:dry": "npm pack --dry-run -w @feelingsarereal/sdoh-loops-pack -w @feelingsarereal/sdoh-loops-core"
  },
  "dependencies": {
    "@feelingsarereal/sdoh-loops-core": "0.4.0",
    "@feelingsarereal/sdoh-loops-pack": "0.1.1",
    "idb-keyval": "6.2.1",
    "js-yaml": "4.1.0",
    "katex": "0.16.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "react-router-dom": "6.28.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.0",
    "remark-math": "6.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.63.0",
    "@types/cytoscape": "3.21.8",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.17.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "fake-indexeddb": "6.0.0",
    "jsdom": "25.0.1",
    "lighthouse": "12.2.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "workspaces": [
    "packages/*"
  ]
}
